IMMICH_URL=https://photos.example.net
IMMICH_API_KEY=plak-hier-je-sleutel
IMMICH_ALBUM=Fotolijst
REFRESH_SECONDS=3600
FRAME_TOKEN=verzin-een-lange-willekeurige-tekst

# Stand: landscape (liggend lijstje, alleen liggende foto's),
#        portrait (staand lijstje, alleen staande foto's), auto (alles; staande gedraaid)
ORIENTATION=auto
# Draairichting van staande foto's: 90 of 270. Staan ze op hun kop: kies de andere.
ROTATION=90

# Beeldinstellingen (1.0 = ongewijzigd)
SATURATION=1.5
CONTRAST=1.2
BRIGHTNESS=1.0
WARMTH=0.0
